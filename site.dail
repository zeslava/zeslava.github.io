FROM 15.0-RELEASE

RUN pkg install -y nginx

COPY --chown=nginx:nginx ./public/ /usr/local/www/site/
COPY --chown=nginx:nginx ./dail/nginx.conf /usr/local/etc/nginx/nginx.conf

RUN mkdir -p /var/log/nginx /var/run/nginx /var/tmp/nginx && chown -R nginx:nginx /var/log/nginx /var/run/nginx /var/tmp/nginx

SERVICE nginx -- /usr/local/sbin/nginx

LOG /var/log/nginx/access.log

EXPOSE 8080:80
